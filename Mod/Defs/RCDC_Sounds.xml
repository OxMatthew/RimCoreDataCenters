<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Original placeholder audio generated by Tools/AssetGen (see NOTICE.md). -->

  <!-- Server rack ambient hum (looped while the rack is powered). -->
  <SoundDef>
    <defName>RCDC_ServerHum</defName>
    <sustain>true</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>RCDC/ServerHum</clipPath>
          </li>
        </grains>
        <volumeRange>7~7</volumeRange>
        <distRange>1~11</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Precision cooling unit fan (looped while the unit is powered). -->
  <SoundDef>
    <defName>RCDC_CoolerFan</defName>
    <sustain>true</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>RCDC/CoolerFan</clipPath>
          </li>
        </grains>
        <volumeRange>9~9</volumeRange>
        <distRange>1~13</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Soft chime when a rack finishes a data cartridge. -->
  <SoundDef>
    <defName>RCDC_CartridgeReady</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>RCDC/CartridgeReady</clipPath>
          </li>
        </grains>
        <volumeRange>11~11</volumeRange>
        <distRange>0~18</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Double beep on emergency thermal shutdown. -->
  <SoundDef>
    <defName>RCDC_RackAlarm</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>RCDC/RackAlarm</clipPath>
          </li>
        </grains>
        <volumeRange>14~14</volumeRange>
        <distRange>0~25</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Low two-tone buzz when a security door turns someone away. -->
  <SoundDef>
    <defName>RCDC_AccessDenied</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>RCDC/AccessDenied</clipPath>
          </li>
        </grains>
        <volumeRange>12~12</volumeRange>
        <distRange>0~20</distRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
