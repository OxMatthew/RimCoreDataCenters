<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Let orbital traders, outlander caravans and outlander settlements BUY data cartridges, including every
    specialized variant. StockGenerator_BuySingleDef only makes a trader willing to buy the item; it never
    adds stock, so traders will not sell cartridges back to the player.
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Orbital_BulkGoods" or defName="Orbital_Exotic" or defName="Caravan_Outlander_BulkGoods" or defName="Caravan_Outlander_Exotic" or defName="Base_Outlander_Standard"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>RCDC_DataCartridge</thingDef>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>RCDC_DataCartridge_Research</thingDef>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>RCDC_DataCartridge_Financial</thingDef>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>RCDC_DataCartridge_Medical</thingDef>
      </li>
    </value>
  </Operation>

</Patch>
